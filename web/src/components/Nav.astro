---
import { getPizzaHunts, getProjects, getSiteSettings } from '../lib/content';
import menuIcon from '../assets/icons/menu.svg?url';
import closeIcon from '../assets/icons/close.svg?url';
import chevronIcon from '../assets/icons/chevron-down.svg?url';
import searchIcon from '../assets/icons/search.svg?url';

/**
 * Bottom bar: the "Menu" pill plus, on Work pages (home + project pages), the
 * project thumbnail strip (on mobile, an "All projects" dropdown). It sits outside the Barba container, so it persists
 * across page transitions; scripts/nav.ts keeps its state in sync.
 */
const { figmaUrl, contactEmail } = await getSiteSettings();
const projects = await getProjects();
const { showInMenu: showPizzaHunts } = await getPizzaHunts();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const activeSlug = path.startsWith('/work/') ? path.slice('/work/'.length) : projects[0]?.slug;
const showStrip = path === '/' || path.startsWith('/work/');
const showSearch = path === '/pizza-hunts';
const links = [
  { label: 'Work', href: '/' },
  { label: 'About', href: '/about' },
  // Hidden when Site settings has no Figma URL
  ...(figmaUrl ? [{ label: 'Figma', href: figmaUrl, external: true }] : []),
  // Hidden when "Show in menu" is off on the Pizza hunts page in Sanity
  ...(showPizzaHunts ? [{ label: 'Pizza hunts', href: '/pizza-hunts' }] : []),
  { label: 'Contact', href: `mailto:${contactEmail}` },
];
---
<nav
  class="site-nav"
  data-nav
  data-open="false"
  data-projects-open="false"
  data-strip={String(showStrip)}
  data-search={String(showSearch)}
  data-searching="false"
  aria-label="Main"
>
  <!-- Pizza hunts only. Desktop (Figma 202:20341): Default, Hover (pink), Typing (pink outline),
       Filled (pink text, × clears). Mobile (204:31800): Typing grows into a panel of suggestions
       above the field, replacing the Menu pill; Clean shows the query with ×. Filters as you type. -->
  <form class="site-nav__search" role="search" data-nav-search data-filled="false">
    <ul class="site-nav__suggestions" aria-label="Suggestions" data-nav-suggestions></ul>
    <div class="site-nav__search-field">
      <label class="visually-hidden" for="nav-search-input">Search pizzerias</label>
      <input
        id="nav-search-input"
        class="site-nav__search-input"
        type="search"
        placeholder="Pizza, country or city"
        autocomplete="off"
        spellcheck="false"
        data-nav-search-input
      />
      <img class="site-nav__icon site-nav__search-icon" src={searchIcon} width="20" height="20" alt="" />
      <button class="site-nav__search-clear" type="button" aria-label="Clear search" data-nav-search-clear>
        <img class="site-nav__icon" src={closeIcon} width="20" height="20" alt="" />
      </button>
    </div>
  </form>

  <div class="site-nav__main" data-nav-main>
    <button class="site-nav__toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="nav-menu">
      Menu
      <img class="site-nav__icon site-nav__icon--menu" src={menuIcon} width="20" height="20" alt="" />
      <img class="site-nav__icon site-nav__icon--close" src={closeIcon} width="20" height="20" alt="" />
    </button>
    <ul id="nav-menu" class="site-nav__menu" data-nav-menu data-open="false">
      {links.map((link) => (
        <li>
          <a
            class="site-nav__link"
            href={link.href}
            data-nav-link
            aria-current={!link.external && (link.href === path || (link.href === '/' && path.startsWith('/work/'))) ? 'page' : undefined}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="site-nav__strip" data-nav-strip>
    <button
      class="site-nav__toggle site-nav__projects-toggle"
      type="button"
      data-projects-toggle
      aria-expanded="false"
      aria-controls="nav-projects"
    >
      All projects
      <img class="site-nav__icon" src={chevronIcon} width="20" height="20" alt="" />
    </button>
    <ul id="nav-projects" class="site-nav__thumbs" aria-label="Projects" data-lenis-prevent>
      {projects.map((project, index) => (
        <li class="site-nav__thumb-item" data-thumb-item data-active={String(project.slug === activeSlug)}>
          <a
            class="site-nav__thumb"
            href={`/work/${project.slug}`}
            data-thumb
            data-index={index}
            data-slug={project.slug}
            aria-label={project.title}
            aria-current={project.slug === activeSlug ? 'true' : undefined}
          >
            <img
              class="site-nav__thumb-image"
              src={project.thumbnail.url}
              width={project.thumbnail.width}
              height={project.thumbnail.height}
              alt=""
            />
            <!-- Slide timer: traced clockwise from the top center; the slider animates it -->
            <svg class="site-nav__thumb-timer" viewBox="0 0 60.57 40" aria-hidden="true">
              <path
                d="M30.29 0H57.37A3.2 3.2 0 0 1 60.57 3.2V36.8A3.2 3.2 0 0 1 57.37 40H3.2A3.2 3.2 0 0 1 0 36.8V3.2A3.2 3.2 0 0 1 3.2 0Z"
                pathLength="1"
                data-thumb-timer
              />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    bottom: var(--nav-bottom);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: var(--space-xsm);
    font-size: var(--body-md-size);
    font-weight: var(--body-md-weight-semibold);
    line-height: normal;
    color: var(--color-black);
  }

  /* All pills share the frosted surface */
  .site-nav__search,
  .site-nav__main,
  .site-nav__strip {
    padding: var(--space-xsm);
    border-radius: var(--radius-md);
    background: var(--surface-glass);
    backdrop-filter: blur(var(--surface-glass-blur));
  }

  .site-nav__main {
    position: relative;
    z-index: 1; /* the open menu slides over the strip */
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    transition: background-color var(--motion-fast) ease;
  }

  @media (hover: hover) {
    .site-nav[data-open='false'] .site-nav__main:hover {
      background: var(--color-pink);
    }
  }

  .site-nav__toggle,
  .site-nav__link {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: none;
  }

  .site-nav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xsm);
    min-height: 32px;
    padding: 6px 12px;
    white-space: nowrap;
    border-radius: var(--radius-sm);
  }

  .site-nav__icon {
    display: block;
  }

  .site-nav__icon--close,
  .site-nav[data-open='true'] .site-nav__icon--menu {
    display: none;
  }

  .site-nav[data-open='true'] .site-nav__icon--close {
    display: block;
  }

  .site-nav__menu {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 6px var(--space-lg);
    white-space: nowrap;
    transition: background-color var(--motion-fast) ease;
  }

  .site-nav__toggle:focus-visible,
  .site-nav__link:focus-visible,
  .site-nav__thumb:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: -2px;
  }

  /* Search — Pizza hunts only. Hidden while the menu is open. */
  .site-nav__search {
    display: none;
    flex-direction: column;
    transition:
      background-color var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .site-nav[data-search='true'][data-open='false'] .site-nav__search {
    display: flex;
  }

  /* Mobile/tablet: a 358px bar (Figma Mobile-Full-Navbar), narrower on
     small phones; the search takes the spare width beside Menu */
  .site-nav[data-search='true'][data-open='false'] {
    width: min(358px, 100% - 2 * var(--grid-margin));
  }

  .site-nav[data-search='true'][data-open='false'] .site-nav__search {
    flex: 1;
    min-width: 0;
  }

  .site-nav__search-field {
    display: flex;
    align-items: center;
    gap: var(--space-xsm);
    border-radius: var(--radius-md);
    transition: box-shadow var(--motion-fast) ease;
  }

  /* Suggestions only show in the mobile Typing panel */
  .site-nav__suggestions {
    display: none;
    flex-direction: column;
    gap: var(--space-xsm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* :global because scripts/nav.ts creates the suggestions, so they miss the scoped attribute */
  .site-nav__suggestions :global(li) {
    display: block;
  }

  .site-nav__suggestions :global(.site-nav__suggestion) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 40px;
    padding: 6px var(--space-lg);
    font: inherit;
    color: inherit;
    background: rgb(255 255 255 / 0.24);
    border: 0;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .site-nav__suggestions :global(.site-nav__suggestion:focus-visible) {
    outline: 2px solid var(--color-black);
    outline-offset: -2px;
  }

  .site-nav__search-icon,
  .site-nav__search-clear {
    margin-right: 12px;
  }

  .site-nav__search-clear {
    display: none;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .site-nav__search-clear:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  /* Typing: pink outline (inset, so the pill doesn't grow) */
  .site-nav__search:has(.site-nav__search-input:focus) {
    box-shadow: inset 0 0 0 1px var(--color-pink);
  }

  /* Filled/Clean (a query, not typing): the search icon becomes ×.
     The text turns pink on desktop only (see the desktop block). */
  .site-nav__search[data-filled='true']:not(:has(.site-nav__search-input:focus)) .site-nav__search-icon {
    display: none;
  }

  .site-nav__search[data-filled='true']:not(:has(.site-nav__search-input:focus)) .site-nav__search-clear {
    display: block;
  }

  .site-nav__search-input {
    flex: 1;
    min-width: 0;
    height: 32px;
    padding: 6px 0 6px 12px;
    font: inherit;
    color: var(--color-black);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    outline: none;
    appearance: none;
  }

  .site-nav__search-input::placeholder {
    color: var(--color-gray-500);
    opacity: 1;
  }

  /* The pill's own clear button would crowd the search icon */
  .site-nav__search-input::-webkit-search-cancel-button {
    appearance: none;
  }


  /* Project strip — Work pages only. A thumbnail row on desktop, an
     "All projects" dropdown on mobile (see the mobile block below). */
  .site-nav__strip {
    display: none;
  }

  .site-nav[data-strip='true'] .site-nav__strip {
    display: block;
  }

  .site-nav__thumbs {
    display: flex;
    gap: var(--space-xsm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__thumb {
    position: relative;
    display: block;
    width: 60.57px;
    height: 40px;
    overflow: hidden;
    border-radius: var(--radius-xs);
  }

  /* ::after dims inactive thumbnails; ::before is the pink hover tint */
  .site-nav__thumb::before,
  .site-nav__thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    transition: opacity var(--motion-fast) ease;
  }

  .site-nav__thumb::before {
    background: rgb(255 0 195 / 0.2);
    opacity: 0;
  }

  .site-nav__thumb::after {
    background: var(--thumb-dim);
  }

  .site-nav__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Half the 4px stroke sits outside the thumbnail and is clipped, as in Figma */
  .site-nav__thumb-timer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-pink);
    stroke-width: 4;
    stroke-dasharray: 1;
    stroke-dashoffset: 0; /* full when not timing (project pages) */
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-fast) ease;
  }

  [data-active='true'] > .site-nav__thumb::after {
    opacity: 0;
  }

  [data-active='true'] > .site-nav__thumb .site-nav__thumb-timer {
    opacity: 1;
  }

  /* Desktop only, like the menu links */
  @media (min-width: 1024px) and (hover: hover) {
    /* Full brightness, with a pink tint on top */
    .site-nav__thumb:hover::after {
      opacity: 0;
    }

    .site-nav__thumb:hover::before {
      opacity: 1;
    }
  }

  /* Mobile open: full-width panel growing upward, stacked links, "Menu ×" at the bottom */
  /* Capped at the Figma panel width (358px) and centered, so tablets get a panel, not a full-width sheet */
  .site-nav[data-open='true'] {
    width: min(358px, 100% - 2 * var(--grid-margin));
  }

  .site-nav[data-open='true'] .site-nav__main {
    width: 100%;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-md) var(--space-sm);
  }

  .site-nav[data-open='true'] .site-nav__toggle {
    order: 1;
  }

  .site-nav[data-open='true'] .site-nav__menu {
    display: flex;
    flex-direction: column;
    gap: var(--space-xsm);
    width: 100%;
  }

  .site-nav[data-open='true'] .site-nav__link {
    width: 100%;
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.24);
  }

  /* Current page (Figma 209:41560); higher specificity than the open-panel fill */
  .site-nav[data-open='true'] .site-nav__link[aria-current='page'] {
    background: var(--color-white);
  }

  /* Mobile "All projects" dropdown (Figma 178:27564). Opening either panel
     hides the other pill; scripts/nav.ts slides it out to the side first. */
  @media (max-width: 1023px) {
    /* Search Typing (Figma 207:38918): the pill becomes a panel — suggestions
       above an outlined field — and the Menu pill steps aside (scripts/nav.ts) */
    .site-nav[data-searching='true'] .site-nav__main {
      display: none;
    }

    .site-nav[data-searching='true'] .site-nav__search {
      gap: var(--space-md);
      padding: var(--space-md) var(--space-md) var(--space-sm);
    }

    .site-nav[data-searching='true'] .site-nav__suggestions:not(:empty) {
      display: flex;
    }

    .site-nav[data-searching='true'] .site-nav__search-field {
      background: var(--surface-glass);
    }

    /* The outline sits on the field here, not the whole panel */
    .site-nav[data-searching='true'] .site-nav__search:has(.site-nav__search-input:focus) {
      box-shadow: none;
    }

    .site-nav[data-searching='true'] .site-nav__search-field:has(.site-nav__search-input:focus) {
      box-shadow: inset 0 0 0 1px var(--color-pink);
    }

    .site-nav[data-open='true'] .site-nav__strip,
    .site-nav[data-projects-open='true'] .site-nav__main {
      display: none;
    }

    .site-nav__thumbs {
      display: none;
    }

    .site-nav[data-projects-open='true'] {
      width: min(358px, 100% - 2 * var(--grid-margin));
    }

    .site-nav[data-projects-open='true'] .site-nav__strip {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-md);
      width: 100%;
      padding: var(--space-md) var(--space-md) var(--space-sm);
    }

    .site-nav[data-projects-open='true'] .site-nav__projects-toggle {
      order: 1;
    }

    /* 107px = 35px from the top of the screen + the panel's padding, gap and toggle */
    .site-nav[data-projects-open='true'] .site-nav__thumbs {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-height: calc(100dvh - var(--nav-bottom) - 107px);
      overflow-y: auto;
      overscroll-behavior: contain;
      border-radius: var(--radius-md);
    }

    .site-nav__thumb-item {
      flex-shrink: 0;
    }

    .site-nav__thumb {
      width: 100%;
      height: auto;
      aspect-ratio: 60.57 / 40;
      border-radius: 6.741px;
    }

    /* The autoplay timer only reads at strip size */
    .site-nav__thumb-timer {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .site-nav__toggle {
      min-height: 40px;
    }

    /* Desktop: a fixed-width pill (278px inside); the bar sizes to its pills */
    .site-nav[data-search='true'][data-open='false'] {
      width: auto;
    }

    /* Filled: pink text */
    .site-nav__search[data-filled='true']:not(:has(.site-nav__search-input:focus)) .site-nav__search-input {
      color: var(--color-pink);
    }

    .site-nav[data-search='true'][data-open='false'] .site-nav__search {
      flex: none;
      width: 286px;
    }

    .site-nav__search-input {
      height: 40px;
    }

    /* Keeps "Menu" anchored left while the pill shrinks back from the link row */
    .site-nav__main {
      align-items: flex-start;
    }

    .site-nav__projects-toggle {
      display: none;
    }

    /* Desktop open: the pill becomes a single row of links, still centered */
    .site-nav[data-open='true'] {
      width: auto;
    }

    .site-nav[data-open='true'] .site-nav__main {
      width: auto;
      flex-direction: row;
      padding: var(--space-xsm);
    }

    .site-nav[data-open='true'] .site-nav__toggle {
      display: none;
    }

    .site-nav[data-open='true'] .site-nav__menu {
      flex-direction: row;
      gap: var(--space-md);
      width: auto;
    }

    .site-nav[data-open='true'] .site-nav__link {
      width: auto;
      background: none;
    }

    .site-nav[data-open='true'] .site-nav__link[aria-current='page'] {
      background: var(--color-white);
    }

    /* Only the active project stays in the strip while the menu is open;
       scripts/nav.ts fades the others out where they stood. */
    .site-nav[data-open='true'] .site-nav__thumb-item:not([data-active='true']) {
      display: none;
    }
  }

  /* Hover is desktop only; on mobile just the current page is marked */
  @media (min-width: 1024px) and (hover: hover) {
    /* Search hover: pink pill, black placeholder (not while typing) */
    .site-nav__search:hover:not(:has(.site-nav__search-input:focus)) {
      background: var(--color-pink);
    }

    .site-nav__search:hover:not(:has(.site-nav__search-input:focus)) .site-nav__search-input::placeholder,
    .site-nav__search:hover:not(:has(.site-nav__search-input:focus)) .site-nav__search-input {
      color: var(--color-black);
    }

    .site-nav[data-open='true'] .site-nav__link:not([aria-current='page']):hover {
      background: var(--color-pink);
    }
  }
</style>
