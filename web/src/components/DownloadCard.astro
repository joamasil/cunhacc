---
/**
 * Figma "Popup" component, Type=Download: translucent card with an outline download button.
 * The whole card is clickable: the download link is stretched over it (as in ContactCard).
 */
import IconButton from './IconButton.astro';
import downloadIcon from '../assets/icons/download.svg?url';

interface Props {
  href: string;
  label?: string;
}
const { href, label = 'Download CV' } = Astro.props;
---
<div class="download-card">
  <p class="download-card__title">{label}</p>
  <IconButton href={href} label={label} icon={downloadIcon} variant="outline" download class="download-card__button" />
</div>

<style>
  .download-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-sm) var(--space-sm) 12px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.65);
    backdrop-filter: blur(var(--surface-glass-blur));
    color: var(--color-black);
  }

  /* Stretched link: covers the card */
  .download-card :global(.download-card__button::after) {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }

  /* Hovering anywhere on the card shows the button's hover state (desktop only) */
  @media (min-width: 1024px) and (hover: hover) {
    .download-card:hover :global(.download-card__button) {
      background: var(--color-black);
    }

    .download-card:hover :global(.download-card__button img) {
      filter: invert(1);
    }
  }

  .download-card__title {
    margin: 0;
    font-size: var(--body-lg-size);
    line-height: var(--body-lg-line-height);
    letter-spacing: var(--body-lg-letter-spacing);
    font-weight: var(--body-lg-weight);
  }
</style>
