---
import type { ProjectMedia } from '../lib/types';

/**
 * Image or video that fills its parent, cropping rather than stretching. Videos autoplay muted and looped;
 * the slider pauses the ones that aren't on screen.
 */
interface Props {
  media: ProjectMedia;
  /** Eager-load (first slide / above the fold). */
  priority?: boolean;
  class?: string;
}
const { media, priority = false, class: className } = Astro.props;
---
{media.type === 'video' ? (
  <video
    class:list={['project-media', className]}
    src={media.url}
    poster={media.poster}
    width={media.width}
    height={media.height}
    aria-label={media.alt}
    muted
    loop
    playsinline
    autoplay={priority}
    preload={priority ? 'auto' : 'metadata'}
    data-media-video
  />
) : (
  <img
    class:list={['project-media', className]}
    src={media.url}
    alt={media.alt}
    width={media.width}
    height={media.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
  />
)}

<style>
  .project-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
