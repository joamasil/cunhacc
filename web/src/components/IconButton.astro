---
import type { HTMLAttributes } from 'astro/types';

/** Round icon button — Figma "Button" component (Black / White / Outline), 32px or 40px ("CTA"). */
interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  label: string;
  icon: string;
  variant?: 'black' | 'white' | 'outline';
  size?: 'md' | 'lg';
  download?: boolean;
  external?: boolean;
}
const { href, label, icon, variant = 'black', size = 'md', download, external, class: className, ...rest } = Astro.props;
---
<a
  class:list={['icon-button', `icon-button--${variant}`, `icon-button--${size}`, className]}
  href={href}
  aria-label={label}
  download={download || undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <img src={icon} width="20" height="20" alt="" />
</a>

<style>
  .icon-button {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--icon-button-size);
    height: var(--icon-button-size);
    border-radius: var(--radius-round);
    transition: background-color var(--motion-fast) ease;
  }

  .icon-button--md {
    --icon-button-size: 32px;
  }

  .icon-button--lg {
    --icon-button-size: 40px;
  }

  .icon-button img {
    display: block;
  }

  .icon-button--black {
    background: var(--color-black);
  }

  .icon-button--white {
    background: var(--color-white);
  }

  .icon-button--outline {
    border: 1px solid var(--color-black);
  }

  .icon-button:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .icon-button--black:hover {
      background: var(--color-pink);
    }

    .icon-button--white:hover {
      background: var(--color-gray-200);
    }

    .icon-button--outline:hover {
      background: var(--color-black);
    }

    /* Figma swaps to a light icon on the filled hover state */
    .icon-button--outline:hover img {
      filter: invert(1);
    }
  }
</style>
