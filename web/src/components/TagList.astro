---
import Tag from './Tag.astro';

interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <ul class="tag-list">
    {tags.map((tag) => <Tag label={tag} />)}
  </ul>
)}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xsm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
