---
import type { Project } from '../lib/types';
import IconButton from './IconButton.astro';
import InfoBlock from './InfoBlock.astro';
import ProjectMedia from './ProjectMedia.astro';
import TagList from './TagList.astro';
import closeIcon from '../assets/icons/close-small.svg?url';

/**
 * The white project sheet ("Popup" in Figma). The surface ([data-panel]) is what
 * the home info card grows into; [data-panel-content] is what fades in/out on
 * open, close and project-to-project switches (scripts/transitions.ts).
 */
interface Props {
  project: Project;
}
const { project } = Astro.props;
const { intro, more } = project.description;

// "Read more +" sits inline at the end of the intro's last paragraph, as in Figma
const toggle =
  '<button type="button" class="project-panel__more-toggle" data-read-more aria-controls="project-more" aria-expanded="false">Read more +</button>';
const introHtml = more ? (/<\/p>\s*$/.test(intro) ? intro.replace(/<\/p>\s*$/, ` ${toggle}</p>`) : `${intro} ${toggle}`) : intro;
---
<article class="project-panel" data-panel aria-labelledby="project-title">
  <!-- Pinned to the panel corner, outside the scrolling columns -->
  <div class="project-panel__close" data-panel-close>
    <IconButton href="/" label="Close project" icon={closeIcon} size="lg" data-project-close />
  </div>

  <!-- Gallery and info scroll independently ([data-panel-scroll], scripts/project-panel.ts) -->
  <div class="project-panel__content" data-panel-content>
    <div class="project-panel__media" data-panel-scroll>
      {project.gallery.map((media, index) => (
        <div class:list={['project-panel__media-item', media.ratio === '1:1' && `project-panel__media-item--square-${media.align}`]}>
          <ProjectMedia media={media} priority={index === 0} />
        </div>
      ))}
    </div>

    <div class="project-panel__info" data-panel-scroll>
      <div class="project-panel__details">
        <header class="project-panel__synopsis">
          <div class="project-panel__heading">
            <h1 id="project-title" class="project-panel__title">{project.title}</h1>
            <p class="project-panel__industry">{project.industry}</p>
          </div>
          <div class="project-panel__description">
            <Fragment set:html={introHtml} />
            {more && <div id="project-more" class="project-panel__more-text" set:html={more} hidden />}
          </div>
          <TagList tags={project.tags} />
        </header>

        {project.infoBlocks.length > 0 && (
          <div class="project-panel__blocks">
            {project.infoBlocks.map((block) => <InfoBlock block={block} />)}
          </div>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-panel {
    position: fixed;
    top: var(--space-md);
    right: var(--space-md);
    bottom: calc(var(--nav-bottom) + var(--nav-height) + var(--space-md));
    left: var(--space-md);
    z-index: var(--z-panel);
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
  }

  .project-panel__content {
    display: grid;
    grid-template-columns: minmax(0, 785fr) minmax(0, 459fr);
    column-gap: calc(var(--space-xxlg) * 2);
    height: 100%;
    padding-inline: var(--space-md);
  }

  /* Each column scrolls on its own; padding sits inside so content scrolls to the panel edge */
  .project-panel__media,
  .project-panel__info {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding-block: var(--space-md);
  }

  .project-panel__media::-webkit-scrollbar,
  .project-panel__info::-webkit-scrollbar {
    display: none;
  }

  .project-panel__media {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .project-panel__media-item {
    flex-shrink: 0; /* keep the ratio; the column scrolls instead */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  /* 1:1 items: half the column, on the side picked in the Studio */
  .project-panel__media-item--square-left,
  .project-panel__media-item--square-right {
    width: calc((100% - var(--space-sm)) / 2);
    aspect-ratio: 1;
  }

  .project-panel__media-item--square-right {
    align-self: flex-end;
  }

  .project-panel__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    z-index: 1;
  }

  .project-panel__info {
    padding-top: calc(var(--space-md) + 40px); /* clears the pinned close button (IconButton size="lg"), as in Figma */
  }

  .project-panel__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxlg);
    width: 100%;
  }

  .project-panel__synopsis {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-panel__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .project-panel__title {
    margin: 0;
    font-size: var(--h2-size);
    line-height: var(--h2-line-height);
    letter-spacing: var(--h2-letter-spacing);
    font-weight: var(--h2-weight);
  }

  .project-panel__industry {
    margin: 0;
  }

  .project-panel__description,
  .project-panel__more-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .project-panel__description :global(p) {
    margin: 0;
  }

  .project-panel__more-text[hidden] {
    display: none;
  }

  /* Injected into the intro HTML, so styled globally; removed once clicked (scripts/project-panel.ts) */
  .project-panel__description :global(.project-panel__more-toggle) {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: var(--body-md-weight-semibold);
    color: var(--color-pink);
    cursor: pointer;
  }

  @media (hover: hover) {
    .project-panel__description :global(.project-panel__more-toggle:hover) {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  .project-panel__industry {
    color: var(--color-gray-500);
  }

  .project-panel__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Desktop-first for now: stack the columns on narrow screens */
  @media (max-width: 1023px) {
    /* One scroll for the whole stacked panel */
    .project-panel__content {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-xlg);
      overflow-y: auto;
      scrollbar-width: none;
    }

    .project-panel__media,
    .project-panel__info {
      height: auto;
      overflow: visible;
    }

    .project-panel__info {
      order: -1;
    }
  }
</style>
